#include "totem.dtsi"

&kscan0 {
    // HARDWARE WORKAROUND: D1 on this controller is dead -- the `r1` joint was
    // reflowed and the row stayed dead, and bridging the r1/c0 pads directly
    // produced nothing, so the fault is inside the module, not on the PCB.
    // Row 1 is bodged to D6 (the `tx` pad) with a wire from the `r1` pad.
    // D7 was not used because the left layer-toggle slider is wired to it.
    row-gpios
        = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // was D1
        , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;

    col-gpios
        = <&xiao_d 4 GPIO_ACTIVE_HIGH>
        , <&xiao_d 5 GPIO_ACTIVE_HIGH>
        , <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        ;
};
