# Dongleless split: the LEFT half is the central. It owns the USB/BLE
# connection to the host and holds the keymap for both sides.
if SHIELD_TOTEM_LEFT

config ZMK_KEYBOARD_NAME
    default "TOTEM Plus 1"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_TOTEM_LEFT || SHIELD_TOTEM_RIGHT

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

endif
